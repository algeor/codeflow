# CodeFlow environment example.
# Copy to .env for local use and replace placeholder values.

# Project config
CODEFLOW_CONFIG=.CodeFlow/config.yaml

# GitHub repository
CODEFLOW_GITHUB_REPO_URL=https://github.com/example-owner/example-repo.git
CODEFLOW_GITHUB_OWNER=example-owner
CODEFLOW_GITHUB_REPO=example-repo
CODEFLOW_BASE_BRANCH=main
CODEFLOW_LOCAL_REPO_PATH=/absolute/path/to/example-repo
CODEFLOW_WORKTREE_ROOT=/absolute/path/to/CodeFlow-worktrees

# Database
CODEFLOW_DATABASE_URL=postgresql://CodeFlow:CodeFlow@localhost:5432/CodeFlow

# GitHub auth fallback. Prefer an already-authenticated gh CLI for local use.
# GITHUB_TOKEN=replace_with_github_token
# GH_TOKEN=replace_with_github_token

# Git identity configured by the implement-init skill.
GIT_USERNAME=Your Name
GIT_EMAIL=you@example.com

# Agent CLI and model routing
CODEFLOW_AGENT_CLI=auto
CODEFLOW_ALLOWED_AGENT_CLIS=claude,codex
CODEFLOW_COST_POLICY=balanced
CODEFLOW_PLANNER_MODEL=
CODEFLOW_CODER_MODEL=
CODEFLOW_REVIEW_MODEL=
CODEFLOW_EMBEDDING_MODEL=

# Runtime limits
CODEFLOW_MAX_ITERATIONS=8
CODEFLOW_MAX_RUNTIME_MINUTES=360
CODEFLOW_BILLING_CURRENCY_CODE=USD
CODEFLOW_MAX_WORKFLOW_BUDGET_MINOR_UNITS=
CODEFLOW_POLL_INTERVAL_SECONDS=60

# Behavior flags
CODEFLOW_REQUIRE_HUMAN_APPROVAL=true
CODEFLOW_ENABLE_RAG=true
CODEFLOW_ENABLE_PR_QUESTIONS=true
CODEFLOW_DRY_RUN=false
